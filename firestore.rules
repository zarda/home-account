rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fields the write actually changes. Updates are validated per changed
    // field because the services issue partial updates ({ isActive: false },
    // { order: index }, { spent }, { lastLoginAt }), and because rows written
    // before these rules existed may be missing — or may hold values that
    // predate — constraints the update never touches.
    function touched(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    // The owner stamp can never be repointed at another account. Absence is
    // tolerated because older rows predate the field.
    function ownerKept(userId) {
      return !('userId' in request.resource.data)
        || request.resource.data.userId == userId;
    }

    function isPositive(value) {
      return value is number && value > 0;
    }

    // ---- transactions ----

    // The receiptUrl scheme allows plain http because the storage emulator
    // issues http://127.0.0.1:9199 download URLs and this same file runs
    // against it; the length cap and scheme check exist so the field can
    // only ever hold a fetchable URL, not a script: payload or a blob of
    // data. receiptUrl must stay a string (never an array): the image quota
    // filters on `receiptUrl > ''`, and Firestore range filters only match
    // values of the operand's type, so an array here would silently drop
    // the row out of the quota count.
    function receiptUrlValid(url) {
      return url is string
        && url.size() < 2048
        && url.matches('https?://.*');
    }

    function txOptionalsValid(d) {
      return (!('baseCurrency' in d) || d.baseCurrency is string)
        && (!('note' in d) || d.note is string)
        && (!('tags' in d) || d.tags is list)
        && (!('receiptUrl' in d) || receiptUrlValid(d.receiptUrl))
        // Entries are not individually type-checked (rules cannot iterate a
        // list); the cap mirrors MAX_RECEIPTS_PER_TRANSACTION client-side
        // and bounds document growth.
        && (!('receiptUrls' in d) || (d.receiptUrls is list && d.receiptUrls.size() <= 5))
        && (!('receiptCount' in d) || (d.receiptCount is int && d.receiptCount >= 0))
        && (!('recurringId' in d) || d.recurringId is string)
        && (!('goalId' in d) || d.goalId is string)
        // The converted-figure snapshot travels with its link: an orphan
        // goalAmount has nothing to be backed out of, so it is unwritable.
        && (!('goalAmount' in d)
            || (d.goalAmount is number && d.goalAmount >= 0 && 'goalId' in d))
        // Same enum budgetCreateValid pins. Transactions were the one place it
        // was accepted unvalidated, because the field never reached a write.
        && (!('period' in d) || d.period in ['weekly', 'monthly', 'yearly'])
        // The map itself was the whole check; country is derived on device
        // from coordinates, so it is worth pinning to the shape the client
        // produces rather than accepting any string.
        && (!('location' in d) || (d.location is map
             && (!('country' in d.location)
                 || (d.location.country is string && d.location.country.size() == 2))))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function txCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll([
             'userId', 'type', 'amount', 'currency', 'amountInBaseCurrency',
             'exchangeRate', 'categoryId', 'description', 'date', 'isRecurring'
           ])
        && d.type in ['income', 'expense']
        && isPositive(d.amount)
        && d.currency is string
        && d.amountInBaseCurrency is number
        && d.exchangeRate is number
        && d.categoryId is string
        && d.description is string
        && d.date is timestamp
        && d.isRecurring is bool
        && txOptionalsValid(d);
    }

    function txUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('type') || ('type' in d && d.type in ['income', 'expense']))
        && (!touched('amount') || ('amount' in d && isPositive(d.amount)))
        && (!touched('currency') || ('currency' in d && d.currency is string))
        && (!touched('amountInBaseCurrency')
            || ('amountInBaseCurrency' in d && d.amountInBaseCurrency is number))
        && (!touched('exchangeRate') || ('exchangeRate' in d && d.exchangeRate is number))
        && (!touched('categoryId') || ('categoryId' in d && d.categoryId is string))
        && (!touched('description') || ('description' in d && d.description is string))
        && (!touched('date') || ('date' in d && d.date is timestamp))
        && (!touched('isRecurring') || ('isRecurring' in d && d.isRecurring is bool))
        && txOptionalsValid(d);
    }

    // ---- budgets ----

    function budgetOptionalsValid(d) {
      return (!('endDate' in d) || d.endDate is timestamp)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && (!('spentPeriod' in d) || d.spentPeriod is string);
    }

    function budgetCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll([
             'userId', 'categoryId', 'name', 'amount', 'currency', 'period',
             'startDate', 'spent', 'isActive', 'alertThreshold'
           ])
        && d.categoryId is string
        && d.name is string
        && isPositive(d.amount)
        && d.currency is string
        && d.period in ['weekly', 'monthly', 'yearly']
        && d.startDate is timestamp
        && d.spent is number
        && d.isActive is bool
        && d.alertThreshold is number
        && budgetOptionalsValid(d);
    }

    function budgetUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('categoryId') || ('categoryId' in d && d.categoryId is string))
        && (!touched('name') || ('name' in d && d.name is string))
        && (!touched('amount') || ('amount' in d && isPositive(d.amount)))
        && (!touched('currency') || ('currency' in d && d.currency is string))
        && (!touched('period')
            || ('period' in d && d.period in ['weekly', 'monthly', 'yearly']))
        && (!touched('startDate') || ('startDate' in d && d.startDate is timestamp))
        && (!touched('spent') || ('spent' in d && d.spent is number))
        && (!touched('isActive') || ('isActive' in d && d.isActive is bool))
        && (!touched('alertThreshold')
            || ('alertThreshold' in d && d.alertThreshold is number))
        && budgetOptionalsValid(d);
    }

    // ---- goals ----

    function goalOptionalsValid(d) {
      // Item elements are validated client-side; rules bound only the shape
      // and size of the list, since per-element map validation is not
      // generically expressible here.
      return (!('items' in d) || (d.items is list && d.items.size() <= 50))
        && (!('linkedAmount' in d)
            || (d.linkedAmount is number && d.linkedAmount >= 0))
        && (!('targetDate' in d) || d.targetDate is timestamp)
        && (!('note' in d) || d.note is string)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function goalCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll([
             'userId', 'kind', 'name', 'targetAmount', 'contributedAmount',
             'currency', 'isActive'
           ])
        && d.kind in ['saving', 'project']
        && d.name is string
        && isPositive(d.targetAmount)
        && d.contributedAmount is number
        && d.contributedAmount >= 0
        && d.currency is string
        && d.isActive is bool
        && goalOptionalsValid(d);
    }

    function goalUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('kind') || ('kind' in d && d.kind in ['saving', 'project']))
        && (!touched('name') || ('name' in d && d.name is string))
        && (!touched('targetAmount')
            || ('targetAmount' in d && isPositive(d.targetAmount)))
        && (!touched('contributedAmount')
            || ('contributedAmount' in d
                && d.contributedAmount is number
                && d.contributedAmount >= 0))
        && (!touched('currency') || ('currency' in d && d.currency is string))
        && (!touched('isActive') || ('isActive' in d && d.isActive is bool))
        && goalOptionalsValid(d);
    }

    // ---- categories ----

    // `id` is tolerated because initializeDefaultCategories copies the
    // document id into the body, and those seeded rows carry no createdAt.
    function categoryOptionalsValid(d) {
      return (!('parentId' in d) || d.parentId is string)
        && (!('id' in d) || d.id is string)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function categoryCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll([
             'userId', 'name', 'icon', 'color', 'type', 'order',
             'isActive', 'isDefault'
           ])
        && d.name is string
        && d.icon is string
        && d.color is string
        && d.type in ['income', 'expense', 'both']
        && d.order is number
        && d.isActive is bool
        && d.isDefault is bool
        && categoryOptionalsValid(d);
    }

    function categoryUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('name') || ('name' in d && d.name is string))
        && (!touched('icon') || ('icon' in d && d.icon is string))
        && (!touched('color') || ('color' in d && d.color is string))
        && (!touched('type')
            || ('type' in d && d.type in ['income', 'expense', 'both']))
        && (!touched('order') || ('order' in d && d.order is number))
        && (!touched('isActive') || ('isActive' in d && d.isActive is bool))
        && (!touched('isDefault') || ('isDefault' in d && d.isDefault is bool))
        && categoryOptionalsValid(d);
    }

    // ---- recurring ----

    // The interval floor is enforced here because an interval below one is
    // not a preference, it is a rule that can never advance — the occurrence
    // walks that read it loop until the tab dies. `is number` is kept rather
    // than tightened to `is int`: nothing guarantees an older document's
    // interval is stored as an integer, and `is int` would deny every write
    // that carries one where it isn't — a restore of an old backup, or an
    // edit that changes the schedule. (A rename or an amount change is
    // untouched either way: the update path only evaluates this when
    // `frequency` is affected.) NaN fails `>= 1` as well, which closes the
    // same hole for a write that does not come from the app at all.
    function frequencyValid(f) {
      return f is map
        && f.keys().hasAll(['type', 'interval'])
        && f.type in ['daily', 'weekly', 'monthly', 'yearly']
        && f.interval is number
        && f.interval >= 1;
    }

    function recurringOptionalsValid(d) {
      return (!('endDate' in d) || d.endDate is timestamp)
        && (!('lastProcessed' in d) || d.lastProcessed is timestamp)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function recurringCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll([
             'userId', 'name', 'type', 'amount', 'currency', 'categoryId',
             'description', 'frequency', 'startDate', 'nextOccurrence', 'isActive'
           ])
        && d.name is string
        && d.type in ['income', 'expense']
        && isPositive(d.amount)
        && d.currency is string
        && d.categoryId is string
        && d.description is string
        && frequencyValid(d.frequency)
        && d.startDate is timestamp
        && d.nextOccurrence is timestamp
        && d.isActive is bool
        && recurringOptionalsValid(d);
    }

    function recurringUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('name') || ('name' in d && d.name is string))
        && (!touched('type') || ('type' in d && d.type in ['income', 'expense']))
        && (!touched('amount') || ('amount' in d && isPositive(d.amount)))
        && (!touched('currency') || ('currency' in d && d.currency is string))
        && (!touched('categoryId') || ('categoryId' in d && d.categoryId is string))
        && (!touched('description') || ('description' in d && d.description is string))
        && (!touched('frequency')
            || ('frequency' in d && frequencyValid(d.frequency)))
        && (!touched('startDate') || ('startDate' in d && d.startDate is timestamp))
        && (!touched('nextOccurrence')
            || ('nextOccurrence' in d && d.nextOccurrence is timestamp))
        && (!touched('isActive') || ('isActive' in d && d.isActive is bool))
        && recurringOptionalsValid(d);
    }

    // ---- saved & recent searches ----

    function searchOptionalsValid(d) {
      return (!('label' in d) || d.label is string)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function searchCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll(['userId', 'query', 'pinned', 'lastUsedAt'])
        && d.query is string
        && d.pinned is bool
        && d.lastUsedAt is timestamp
        && searchOptionalsValid(d);
    }

    function searchUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('query') || ('query' in d && d.query is string))
        && (!touched('pinned') || ('pinned' in d && d.pinned is bool))
        && (!touched('lastUsedAt')
            || ('lastUsedAt' in d && d.lastUsedAt is timestamp))
        && searchOptionalsValid(d);
    }

    // ---- persisted smart-search answers ----

    function isDayKey(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // The stored scope is the resolved range the figures were computed over.
    // Dates are day keys, not timestamps: the client revives them at local
    // midnight, and a timestamp here would smuggle a timezone into a record
    // that is defined by calendar days.
    function answerScopeValid(s) {
      return s is map
        && s.keys().hasOnly(['type', 'categoryId', 'startDate', 'endDate',
                             'minAmount', 'maxAmount', 'currency', 'searchQuery',
                             'goalId'])
        && s.keys().hasAll(['startDate', 'endDate'])
        && isDayKey(s.startDate)
        && isDayKey(s.endDate)
        && (!('type' in s) || s.type in ['income', 'expense'])
        && (!('categoryId' in s) || s.categoryId is string)
        && (!('minAmount' in s) || s.minAmount is number)
        && (!('maxAmount' in s) || s.maxAmount is number)
        && (!('currency' in s) || s.currency is string)
        && (!('searchQuery' in s) || s.searchQuery is string)
        // A goal-scoped question ("how much toward the Japan trip") stores
        // the goal it resolved to; a budget-scoped one does not, because a
        // budget resolves to a category and a window before it gets here.
        && (!('goalId' in s) || s.goalId is string);
    }

    // `!('x' in d)` style rather than touched(): a refresh clears a vanished
    // currency, extreme-row id or category breakdown via deleteField, and
    // touched() is true for a deleted key that is absent from the incoming
    // data — the searchUpdateValid pattern would reject exactly the deletions
    // the service must issue.
    function answerOptionalsValid(d) {
      return (!('currency' in d) || d.currency is string)
        && (!('extremeTransactionId' in d) || d.extremeTransactionId is string)
        && (!('groups' in d) || d.groups is list)
        // Optional because records written before pinning existed do not
        // carry it. Typed here rather than frozen in answerUpdateValid, which
        // is what lets the pin be toggled: it is a decision about the record,
        // not part of the identity a refresh must not disturb.
        && (!('pinned' in d) || d.pinned is bool)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function answerCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasOnly(['userId', 'schemaVersion', 'query', 'operation', 'limit',
                             'scope', 'baseCurrency', 'value', 'currency',
                             'transactionCount', 'extremeTransactionId', 'groups',
                             'pinned', 'computedAt', 'lastUsedAt',
                             'createdAt', 'updatedAt'])
        && d.keys().hasAll(['userId', 'schemaVersion', 'query', 'operation', 'limit',
                            'scope', 'baseCurrency', 'value', 'transactionCount',
                            'computedAt', 'lastUsedAt'])
        && d.schemaVersion is int && d.schemaVersion > 0
        && d.query is string && d.query.size() > 0
        && d.operation in ['sum', 'count', 'average', 'max', 'min', 'topCategories']
        && d.limit is int && d.limit >= 1 && d.limit <= 10
        && answerScopeValid(d.scope)
        && d.baseCurrency is string
        && d.value is number
        && d.transactionCount is int && d.transactionCount >= 0
        && d.computedAt is timestamp
        && d.lastUsedAt is timestamp
        && answerOptionalsValid(d);
    }

    function answerUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        // The question and its resolved scope are the record's identity; a
        // refresh replaces the figures, never what was asked.
        && !touched('query') && !touched('operation') && !touched('limit')
        && !touched('scope') && !touched('schemaVersion')
        && (!touched('baseCurrency')
            || ('baseCurrency' in d && d.baseCurrency is string))
        && (!touched('value') || ('value' in d && d.value is number))
        && (!touched('transactionCount')
            || ('transactionCount' in d
                && d.transactionCount is int && d.transactionCount >= 0))
        && (!touched('computedAt')
            || ('computedAt' in d && d.computedAt is timestamp))
        && (!touched('lastUsedAt')
            || ('lastUsedAt' in d && d.lastUsedAt is timestamp))
        && answerOptionalsValid(d);
    }

    // ---- category memory ----

    // The document id is the normalized merchant key, and the entry repeats it
    // so a row cannot claim to be about a merchant it is not filed under.
    // A closed field set is safe here: the collection cannot predate its own
    // rule, so there are no legacy shapes to accommodate.
    function categoryMemoryValid(merchantKey) {
      let d = request.resource.data;
      return d.keys().hasOnly(['merchantKey', 'categoryId', 'sampleDescription', 'count', 'updatedAt'])
        && d.keys().hasAll(['merchantKey', 'categoryId', 'sampleDescription', 'count'])
        && d.merchantKey == merchantKey
        && d.categoryId is string
        && d.categoryId.size() > 0
        && d.sampleDescription is string
        && d.count is int
        && d.count > 0
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // ---- import history ----

    function importStatuses() {
      return ['pending', 'processing', 'completed', 'partial', 'failed'];
    }

    function importOptionalsValid(d) {
      return (!('errors' in d) || d.errors is list)
        && (!('fileSize' in d) || d.fileSize is number)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function importCreateValid(userId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasAll([
             'userId', 'importedAt', 'source', 'fileType', 'fileName', 'status'
           ])
        && d.importedAt is timestamp
        && d.source in ['csv', 'pdf', 'image', 'json']
        && d.fileType is string
        && d.fileName is string
        && d.status in importStatuses()
        && importOptionalsValid(d);
    }

    function importUpdateValid(userId) {
      let d = request.resource.data;
      return ownerKept(userId)
        && (!touched('importedAt') || ('importedAt' in d && d.importedAt is timestamp))
        && (!touched('source')
            || ('source' in d && d.source in ['csv', 'pdf', 'image', 'json']))
        && (!touched('fileName') || ('fileName' in d && d.fileName is string))
        && (!touched('status') || ('status' in d && d.status in importStatuses()))
        && importOptionalsValid(d);
    }

    // ---- insight snapshots ----

    // `yyyy-MM`. The first regex validator in this file; the month key is both
    // the document id and a stored field, and they have to agree.
    function isMonthKey(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function snapshotFingerprintValid(f) {
      return f is map
        && f.keys().hasOnly(['tx', 'count', 'timeZone', 'baseCurrency'])
        && f.tx is string
        && f.count is int && f.count >= 0
        && f.timeZone is string
        && f.baseCurrency is string;
    }

    // Create and update share one validator: a regeneration rewrites the whole
    // document rather than patching it, so there is no partial-update shape to
    // tolerate here.
    //
    // `is int` holds only because the SDK writes integral JS numbers as
    // integerValue, so anything computed must be rounded before assignment.
    function snapshotValid(userId, monthId) {
      let d = request.resource.data;
      return d.userId == userId
        && d.keys().hasOnly([
             'userId', 'monthKey', 'detectorVersion', 'schemaVersion', 'status',
             'fingerprint', 'totals', 'byCategory', 'facts', 'cards',
             'generatedAt', 'createdAt', 'updatedAt', 'revision'
           ])
        && d.keys().hasAll([
             'userId', 'monthKey', 'detectorVersion', 'schemaVersion', 'status',
             'fingerprint', 'totals', 'byCategory', 'facts', 'cards',
             'generatedAt', 'createdAt', 'revision'
           ])
        // The month key can never be repointed at a different month.
        && d.monthKey == monthId
        && isMonthKey(d.monthKey)
        && d.detectorVersion is int && d.detectorVersion > 0
        && d.schemaVersion is int && d.schemaVersion > 0
        && d.status == 'complete'
        && snapshotFingerprintValid(d.fingerprint)
        && d.totals is map
        && d.byCategory is list
        && d.facts is map
        && d.cards is list
        && d.generatedAt is timestamp
        && d.createdAt is timestamp
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && d.revision is int && d.revision > 0;
    }

    // ---- user profile ----

    function userOptionalsValid(d) {
      return (!('photoURL' in d) || d.photoURL is string)
        && (!('subscription' in d) || d.subscription is map)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // photoURL is omitted, not null, when the provider has no picture.
    function userCreateValid() {
      let d = request.resource.data;
      return d.keys().hasAll([
             'email', 'displayName', 'createdAt', 'lastLoginAt', 'preferences'
           ])
        && d.email is string
        && d.displayName is string
        && d.createdAt is timestamp
        && d.lastLoginAt is timestamp
        && d.preferences is map
        && userOptionalsValid(d);
    }

    function userUpdateValid() {
      let d = request.resource.data;
      return (!touched('email') || ('email' in d && d.email is string))
        && (!touched('displayName') || ('displayName' in d && d.displayName is string))
        && (!touched('createdAt') || ('createdAt' in d && d.createdAt is timestamp))
        && (!touched('lastLoginAt')
            || ('lastLoginAt' in d && d.lastLoginAt is timestamp))
        && (!touched('preferences') || ('preferences' in d && d.preferences is map))
        && userOptionalsValid(d);
    }

    // Retired shared exchange-rate cache. It was readable and writable by
    // every authenticated user, so one account could rewrite the rates that
    // convert every other account's stored amounts — and a poisoned rate is
    // perfectly well shaped, so no validator can tell it from a real one.
    // Rates are global data with a public source, so the cache moved to
    // device-local storage rather than to another Firestore location.
    match /currencies/{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      // Users can only read/write their own document
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && userCreateValid();
      allow update: if isOwner(userId) && userUpdateValid();
      allow delete: if isOwner(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && txCreateValid(userId);
        allow update: if isOwner(userId) && txUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && budgetCreateValid(userId);
        allow update: if isOwner(userId) && budgetUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && goalCreateValid(userId);
        allow update: if isOwner(userId) && goalUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && categoryCreateValid(userId);
        allow update: if isOwner(userId) && categoryUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Recurring transactions subcollection
      match /recurring/{recurringId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && recurringCreateValid(userId);
        allow update: if isOwner(userId) && recurringUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Saved & recent searches subcollection
      match /savedSearches/{searchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && searchCreateValid(userId);
        allow update: if isOwner(userId) && searchUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Remembered merchant→category corrections, keyed by merchant
      match /categoryMemory/{merchantKey} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && categoryMemoryValid(merchantKey);
        allow delete: if isOwner(userId);
      }

      // Import history subcollection
      match /imports/{importId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && importCreateValid(userId);
        allow update: if isOwner(userId) && importUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Provider API keys, kept out of the broadly-subscribed user document.
      // Closed field set for the same reason as securityEvents: the
      // collection cannot predate its own rule, so there are no legacy
      // documents to tolerate, and this one holds credentials.
      match /secrets/{docId} {
        allow read: if isOwner(userId);
        // create/update carry request.resource and validate the field shape.
        // delete carries none, so a combined `write` grant would error on the
        // request.resource checks and silently deny every delete — account
        // deletion purges this document, so delete gets its own grant.
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['gemini', 'openai', 'claude', 'updatedAt'])
          && (!('gemini' in request.resource.data) || request.resource.data.gemini is string)
          && (!('openai' in request.resource.data) || request.resource.data.openai is string)
          && (!('claude' in request.resource.data) || request.resource.data.claude is string);
        allow delete: if isOwner(userId);
      }

      // Sign-in history. Unrewritable on purpose: this log is what a user
      // checks after a suspected compromise, so a client that holds the
      // credentials must not be able to change what an entry says. Deletion
      // is the one exception — account deletion has to be able to empty the
      // log, and a rule cannot tell "delete my account" apart from "delete
      // one event"; a credential thief gains nothing new, since the whole
      // account was already theirs to delete. The closed field set is safe
      // to require here, unlike elsewhere in this file, because the
      // collection cannot predate the rule and so has no legacy rows.
      match /securityEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.type == 'signIn'
          && request.resource.data.occurredAt is timestamp
          && request.resource.data.platform is string
          && request.resource.data.keys().hasOnly(
               ['userId', 'type', 'occurredAt', 'platform', 'createdAt', 'updatedAt']);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Monthly spending-insight snapshots, keyed by `yyyy-MM`.
      //
      // Point-in-time records. The closed field set is safe to require here,
      // as with securityEvents, because the collection cannot predate its own
      // rule and so has no legacy rows.
      //
      // Unlike securityEvents these are not an audit trail. The owner is
      // entitled to remove them and account deletion has to, and a rule cannot
      // tell "deleting my account" apart from "deleting one snapshot", so
      // delete is allowed. That makes these immutable in practice rather than
      // immutable by rule: a rewrite must revalidate the whole document, must
      // keep the month key pinned to the document id, and must advance
      // `revision`, so a regeneration is recorded instead of history being
      // silently amended.
      match /insightSnapshots/{monthId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && snapshotValid(userId, monthId);
        allow update: if isOwner(userId)
          && snapshotValid(userId, monthId)
          && request.resource.data.revision > resource.data.revision;
        allow delete: if isOwner(userId);
      }

      // Persisted smart-search answers: point-in-time snapshots of locally
      // computed aggregates, keyed by recency. The closed field set is safe
      // to require, as with securityEvents, because the collection cannot
      // predate its own rule and so has no legacy rows. Updates may replace
      // the figures (a local refresh) but never the question or its resolved
      // scope — those are the record's identity. Delete is allowed: the owner
      // prunes past the cap from the client and may discard records at will.
      match /searchAnswers/{answerId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && answerCreateValid(userId);
        allow update: if isOwner(userId) && answerUpdateValid(userId);
        allow delete: if isOwner(userId);
      }

      // Any other subcollections under user, including ones added later.
      // Rules are additive — an allow here cannot be narrowed by the blocks
      // above — so every validated collection must be carved out, or its
      // field checks would simply be bypassable through this match.
      match /{subcollection}/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && !(subcollection in [
          'transactions', 'budgets', 'categories', 'goals',
          'recurring', 'savedSearches', 'imports', 'securityEvents', 'secrets',
          'insightSnapshots', 'categoryMemory', 'searchAnswers'
        ]);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
