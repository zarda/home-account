{
  "name": "home-account",
  "version": "1.24.135",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:smoke": "ng test --watch=false --browsers=ChromeHeadless --include='**/*.smoke.spec.ts'",
    "test:smoke:dates": "ng test --watch=false --browsers=ChromeHeadless --include='**/period-window.smoke.spec.ts' --include='**/transaction.service.smoke.spec.ts' --include='**/recurring.service.smoke.spec.ts'",
    "test:dates": "ng test --watch=false --browsers=ChromeHeadless --include='**/transaction-date.utils.spec.ts' --include='**/export.service.spec.ts' --include='**/receipt-text-parser.spec.ts' --include='**/nl-search.utils.spec.ts' --include='**/search-answer.utils.spec.ts' --include='**/insight-card.component.spec.ts' --include='**/recurring.service.spec.ts' --include='**/recurring-conversion.utils.spec.ts' --include='**/forecast-series.utils.spec.ts' --include='**/cloud-llm-provider.base.spec.ts' --include='**/native-receipt.service.spec.ts' --include='**/rag-context.service.spec.ts' --include='**/recent-transactions.component.spec.ts' --include='**/date-format.service.spec.ts' --include='**/locale-format.service.spec.ts'",
    "smoke": "firebase emulators:exec --only auth,storage,firestore --project demo-home-account \"npm run test:smoke\"",
    "smoke:dates": "firebase emulators:exec --only auth,storage,firestore --project demo-home-account \"TZ=America/New_York npm run test:smoke:dates && TZ=Asia/Tokyo npm run test:smoke:dates\"",
    "test:ios": "xcodebuild test -project ios/App/App.xcodeproj -scheme AppTests -destination 'platform=iOS Simulator,name=iPhone 17' -quiet",
    "lint": "ng lint",
    "lint-guards:check": "node scripts/check-lint-guards.mjs --self-test && node scripts/check-lint-guards.mjs",
    "i18n:check": "node scripts/check-i18n.mjs --self-test && node scripts/check-i18n.mjs",
    "analytics:check": "node scripts/check-analytics-registry.mjs",
    "prompts:check": "node scripts/check-prompts.mjs --self-test && node scripts/check-prompts.mjs",
    "indexes:check": "node scripts/check-firestore-indexes.mjs",
    "truncation:check": "node scripts/check-truncation.mjs",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "build:ios": "ng build --configuration=production-local && npx cap sync ios",
    "build:web": "npm run build:prod",
    "postinstall": "bash scripts/patch-capacitor-firebase-auth.sh",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage --exclude='**/*.smoke.spec.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/service-worker": "^22.1.2",
    "@anthropic-ai/sdk": "^0.104.1",
    "@capacitor-firebase/analytics": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@google/generative-ai": "^0.24.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.15.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "ng2-charts": "^10.0.0",
    "openai": "^4.96.0",
    "pdfjs-dist": "^6.1.200",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@angular/localize": "^22.1.2",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "firebase-tools": "^15.20.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.0"
  }
}
